# Supabase project — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Service role key (Settings → API). Server-side only — never expose to the browser.
# Used by the /api/sync/* routes to write teams, games and scores.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required by the sync routes. Generate with: openssl rand -hex 32
SYNC_SECRET=

# Public origin, used to build invite links and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Season the app defaults to.
NEXT_PUBLIC_DEFAULT_SEASON=2026
