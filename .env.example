# Supabase — project "Pickem" (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://lajgkmeonhysxjeoujzv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SxPXPNbHqk91cRFo5kbrLA_w0Ql7hT1

# Service role key (Settings → API → service_role). Server-side only — never
# expose to the browser. Only the /api/sync/* routes need it.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret guarding the sync routes. Generate with: openssl rand -hex 32
SYNC_SECRET=

# Public origin, used to build invite links and auth redirects. Production is
# https://pickemweekly.com — set it in Vercel, where it is inlined at build
# time, so a change needs a redeploy to take effect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Season new leagues default to.
NEXT_PUBLIC_DEFAULT_SEASON=2026
